{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "savebyai-web",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "savebyai-growth",
      "database_id": "ecf241c8-14c1-4647-93eb-d01989603698"
    }
  ]
}
